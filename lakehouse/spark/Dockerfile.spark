FROM bitnami/spark:3.5

USER root

# ── Install Iceberg, Kafka, and AWS SDK JARs ────────────────
ENV ICEBERG_VERSION=1.5.2
ENV SPARK_VERSION=3.5
ENV AWS_SDK_VERSION=2.23.19

RUN mkdir -p /opt/bitnami/spark/jars

# Apache Iceberg runtime
ADD --chmod=644 https://repo1.maven.org/maven2/org/apache/iceberg/iceberg-spark-runtime-${SPARK_VERSION}_2.12/${ICEBERG_VERSION}/iceberg-spark-runtime-${SPARK_VERSION}_2.12-${ICEBERG_VERSION}.jar /opt/bitnami/spark/jars/

# Iceberg AWS integration
ADD --chmod=644 https://repo1.maven.org/maven2/org/apache/iceberg/iceberg-aws-bundle/${ICEBERG_VERSION}/iceberg-aws-bundle-${ICEBERG_VERSION}.jar /opt/bitnami/spark/jars/

# Spark Kafka connector
ADD --chmod=644 https://repo1.maven.org/maven2/org/apache/spark/spark-sql-kafka-0-10_2.12/3.5.1/spark-sql-kafka-0-10_2.12-3.5.1.jar /opt/bitnami/spark/jars/
ADD --chmod=644 https://repo1.maven.org/maven2/org/apache/kafka/kafka-clients/3.5.1/kafka-clients-3.5.1.jar /opt/bitnami/spark/jars/
ADD --chmod=644 https://repo1.maven.org/maven2/org/apache/spark/spark-token-provider-kafka-0-10_2.12/3.5.1/spark-token-provider-kafka-0-10_2.12-3.5.1.jar /opt/bitnami/spark/jars/
ADD --chmod=644 https://repo1.maven.org/maven2/org/apache/commons/commons-pool2/2.12.0/commons-pool2-2.12.0.jar /opt/bitnami/spark/jars/

# Hadoop AWS (S3A filesystem)
ADD --chmod=644 https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-aws/3.3.4/hadoop-aws-3.3.4.jar /opt/bitnami/spark/jars/
ADD --chmod=644 https://repo1.maven.org/maven2/com/amazonaws/aws-java-sdk-bundle/1.12.262/aws-java-sdk-bundle-1.12.262.jar /opt/bitnami/spark/jars/

# ── Copy application code ───────────────────────────────────
COPY streaming_to_iceberg.py /app/streaming_to_iceberg.py
COPY spark-defaults.conf /opt/bitnami/spark/conf/spark-defaults.conf

WORKDIR /app

ENTRYPOINT ["spark-submit", \
    "--master", "local[*]", \
    "--conf", "spark.driver.memory=2g", \
    "--conf", "spark.executor.memory=2g", \
    "/app/streaming_to_iceberg.py"]
